{
  "manifest_version": 3,
  "name": "YouTube — Qualidade Máxima",
  "version": "2.0.0",
  "description": "Seleciona automaticamente a maior qualidade disponível nos vídeos do YouTube.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "quality.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Max"
  }
}