{
  "manifest_version": 3,
  "name": "YouTube — Qualidade Máxima",
  "version": "2.1.0",
  "description": "Seleciona a qualidade desejada no YouTube, com opção de máxima disponível e preferência por bitrate Premium.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "quality.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Max",
    "default_icon": {
      "16": "icons/max-16.png",
      "32": "icons/max-32.png",
      "48": "icons/max-48.png",
      "128": "icons/max-128.png"
    }
  },
  "icons": {
    "16": "icons/max-16.png",
    "32": "icons/max-32.png",
    "48": "icons/max-48.png",
    "128": "icons/max-128.png"
  }
}
